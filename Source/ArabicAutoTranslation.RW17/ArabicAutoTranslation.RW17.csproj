<Project Sdk="Microsoft.NET.Sdk">

  <!--
    RimWorld 1.7 build. RimWorld 1.7 runs on .NET 10, so this project targets net10.0 and defines RW17.
    It compiles the very same sources as every other version (Source/ArabicAutoTranslation).

    By default it compiles against the public RimWorld reference packages from NuGet, so it builds on any machine
    and on GitHub Actions (it is what .github/workflows/build.yml uses):

        dotnet build Source/ArabicAutoTranslation.RW17/ArabicAutoTranslation.RW17.csproj -c Release -o build/1.7

    Without -o the DLL is written to 1.7/Assemblies of this repository.

    The RimWorld 1.7 reference packages are published on NuGet as "unstable" (for example 1.7.4998-unstable), which
    is why the versions below are prerelease wildcards. To pin one build, add -p:RimWorldRefVersion=1.7.4998-unstable
    To compile against your own RimWorld 1.7 install instead of NuGet, add -p:UseGameFiles=true
    (RimWorldRoot is the game folder that holds Assembly-CSharp.dll, HarmonyDll is the Harmony 1.7 dll; both can be
    overridden with -p:).
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>ArabicAutoTranslation</AssemblyName>
    <RootNamespace>ArabicAutoTranslation</RootNamespace>
    <DefineConstants>$(DefineConstants);RW17</DefineConstants>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Deterministic>true</Deterministic>
    <Optimize>true</Optimize>
    <DebugType>portable</DebugType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>..\..\1.7\Assemblies\</OutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <NoWarn>$(NoWarn);CS1701;CS1702;CS0618;SYSLIB0014;CA1416</NoWarn>

    <SharedSource>..\ArabicAutoTranslation</SharedSource>
  </PropertyGroup>

  <!-- NuGet reference packages (default). -->
  <PropertyGroup>
    <RimWorldRefVersion Condition="'$(RimWorldRefVersion)' == ''">1.7.*-*</RimWorldRefVersion>
    <HarmonyRefVersion Condition="'$(HarmonyRefVersion)' == ''">3.0.*-*</HarmonyRefVersion>
  </PropertyGroup>

  <!-- Your own RimWorld 1.7 install (only with -p:UseGameFiles=true). -->
  <PropertyGroup>
    <RimWorldRoot>$(MSBuildProjectDirectory)\..\..\..\..</RimWorldRoot>
    <HarmonyDll>$(RimWorldRoot)\..\..\workshop\content\294100\2009463077\1.7\Assemblies\0Harmony.dll</HarmonyDll>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(SharedSource)\**\*.cs" Exclude="$(SharedSource)\obj\**;$(SharedSource)\bin\**" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseGameFiles)' != 'true'">
    <PackageReference Include="Krafs.Rimworld.Ref" Version="$(RimWorldRefVersion)" PrivateAssets="all" />
    <PackageReference Include="Lib.Harmony" Version="$(HarmonyRefVersion)" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseGameFiles)' == 'true'">
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldRoot)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityStubs">
      <HintPath>$(RimWorldRoot)\UnityStubs.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyDll)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Lists in the build log which game assemblies came from the NuGet package (helps when reading a failed build). -->
  <Target Name="AtShowGameRefs" AfterTargets="ResolveAssemblyReferences" Condition="'$(UseGameFiles)' != 'true'">
    <ItemGroup>
      <AtGameRef Include="@(ReferencePath)" Condition="'%(NuGetPackageId)' == 'Krafs.Rimworld.Ref'" />
    </ItemGroup>
    <Message Importance="high" Text="RimWorld 1.7 reference assemblies from Krafs.Rimworld.Ref: @(AtGameRef->'%(Filename)', ', ')" />
  </Target>

</Project>
